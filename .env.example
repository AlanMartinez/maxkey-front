# Backend deploy URL, e.g. https://maxkeys-api.fly.dev (feeds runtimeConfig.public.apiBaseUrl)
NUXT_PUBLIC_API_BASE_URL=http://localhost:8080
# This site's own public URL, used for the Supabase OAuth redirectTo
NUXT_PUBLIC_SITE_URL=http://localhost:3000
# Supabase project URL (consumed by @nuxtjs/supabase)
SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase anon/publishable key only — never the service role key
SUPABASE_KEY=your-anon-key
